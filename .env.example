# trmnl-joan-bridge configuration
#
# Copy this file to .env and fill in the values for your setup, then run
# ./deploy.sh (see the README's Home Assistant mode / Docker sections).
# .env is gitignored — never commit it (it holds a live HA long-lived token).

# Content source: "ha" (Home Assistant, default) or "trmnl".
SOURCE=ha

# --- Home Assistant mode (required when SOURCE=ha or unset) ---

# Home Assistant base URL, no trailing slash. Required.
HA_URL=http://10.218.10.81:8123

# Home Assistant long-lived access token. Required.
# Create one at: your HA profile -> Security -> Long-Lived Access Tokens.
HA_TOKEN=REPLACE_WITH_YOUR_HA_LONG_LIVED_ACCESS_TOKEN

# Path to the page/touch-zone config file. Optional, default: zones.json
ZONES_FILE=zones.json

# Chromium executable name/path used to render the dashboard. Optional,
# default: chromium. The Dockerfile already sets this to "headless-shell"
# for the container image, so leave it commented out/unset for Docker
# deployments — only set it if you're running the Go binary directly on a
# host with a differently-named Chromium build.
#CHROMIUM_BIN=chromium

# Milliseconds to let the dashboard finish loading (HA's frontend is a full
# SPA that needs a live websocket connection) before screenshotting it.
# Optional, default: 4000
RENDER_WAIT_MS=4000

# Directory to save the latest render to (as latest-render.png) for
# diagnosis — e.g. to tell a stuck login screen apart from a real rendering
# problem. Optional, unset/disabled by default.
#DEBUG_SAVE_SCREENSHOTS=./debug-screenshots

# --- TRMNL mode only (irrelevant if SOURCE=ha) ---

# TRMNL server base URL, e.g. http://192.168.1.210:2300
#TRMNL_SERVER=http://192.168.1.210:2300

# Joan device MAC address, uppercase, e.g. 42:00:28:00:0D:51
#DEVICE_ID=42:00:28:00:0D:51

# TRMNL device access token
#ACCESS_TOKEN=REPLACE_WITH_YOUR_TRMNL_ACCESS_TOKEN

# --- Shared configuration (both modes) ---

# Fallback re-render/re-fetch interval. Go duration syntax (e.g. 60s, 5m).
# Optional, default: 60s
REFRESH_INTERVAL=60s

# TCP listen address for the Joan panel to connect to. Optional, default: :11112
LISTEN_ADDR=:11112
